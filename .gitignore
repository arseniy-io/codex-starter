# Секреты и локальные настройки - никогда не коммитить
.env
.env.local
.env.*.local
*.pem
*.key

# business/ создаётся AUTOPILOT локально и может содержать стратегию,
# экономику, клиентов, raw-транскрипты и другие приватные данные проекта.
# Пример структуры смотри в examples/ и шаблонах, а не в корневой business/.
/business/

# ai-clone/ и mastery/ в шаблоне тоже плейсхолдеры. После POST_AUTOPILOT.md реши:
# коммитить их только в приватный repo или снять с tracking, если там личные данные.

# Локальные настройки Codex
.codex/config.local.toml
.codex/*.local.toml

# Зависимости
node_modules/
.pnpm-store/
.yarn/

# Сборки
.next/
dist/
build/
out/

# Системные
.DS_Store
Thumbs.db

